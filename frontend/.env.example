# Адрес Car Ads API. Используется только на сервере: страницы — серверные
# компоненты, форма отправляется через Server Action, поэтому браузер к API
# напрямую не обращается и CORS не нужен.
#
# Локально:      https://car-api.mikek8.ru
# Внутри k3s:    http://car-ads-api  (Service в том же namespace)
CAR_API_URL=https://car-api.mikek8.ru
